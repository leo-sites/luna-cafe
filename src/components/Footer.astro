---
import business from '../data/business.json';

const telLink = `tel:+1${business.phone.replace(/\D/g, '')}`;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div>
      <strong>{business.name}</strong>
      <p>{business.address}</p>
    </div>
    <div>
      <p>Call us: <a href={telLink}>{business.phone}</a></p>
      <p>Email: <a href={`mailto:${business.email}`}>{business.email}</a></p>
      <p><a href={business.social.instagram}>Instagram</a></p>
    </div>
  </div>
  <p class="copyright">© {year} {business.name}. All rights reserved.</p>
</footer>

<style>
  .site-footer {
    background: var(--color-text);
    color: var(--color-bg);
    padding: 2rem 0 1rem;
  }
  .site-footer .container {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: space-between;
  }
  .site-footer a {
    color: var(--color-accent);
  }
  .copyright {
    text-align: center;
    font-size: 0.875rem;
    opacity: 0.7;
  }
</style>
