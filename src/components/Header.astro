---
import business from '../data/business.json';
import { url } from '../lib/url';
---

<header class="site-header">
  <div class="container">
    <a class="logo" href={url()}>{business.name}</a>
    <nav>
      <a href={url()}>Home</a>
      <a href={url('menu/')}>Menu</a>
      <a href={url('#visit')}>Visit us</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-primary);
    padding: 1rem 0;
  }
  .site-header .container {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
  }
  .logo {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--color-bg);
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 1.25rem;
  }
  nav a {
    color: var(--color-bg);
    text-decoration: none;
  }
</style>
